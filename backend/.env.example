# Placement Mailer - Backend Environment Variables
# Copy this file to .env and fill in your details:
# cp .env.example .env

# Your Gmail address used to send emails
GMAIL_USER=your_email@gmail.com

# 16-character Google App Password (NOT your regular Gmail account password)
# Generate from: Google Account > Security > 2-Step Verification > App passwords
# Paste the 16 letters here (spaces are automatically stripped if present)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Sender Name that appears in the "From:" header (e.g., "Alex Smith")
SENDER_NAME=Your Full Name

# Server Port (default: 5000)
PORT=5000
